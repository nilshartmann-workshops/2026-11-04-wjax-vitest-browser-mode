{
  "name": "huetly",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "backend:start": "cd ../backend && pnpm start",
    "backend:dev": "cd ../backend && pnpm dev",
    "backend": "cd ../backend && pnpm dev",
    "dev": "vite dev --port 3000",
    "build": "rm -f tsconfig.tsbuildinfo && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:browser": "vitest --project browser",
    "test:browser:update": "vitest run --project browser -u",
    "test:coverage": "vitest run --coverage",
    "test:trace": "bash ../show-trace.sh",
    "generate:api": "openapi-ts",
    "lint": "eslint",
    "check": "rm -f tsconfig.tsbuildinfo && prettier --write . && eslint --fix && tsc -b --noEmit",
    "check:lint": "eslint",
    "check:prettier": "prettier --check .",
    "check:ts": "tsc -b --noEmit",
    "clean": "rm -rf dist node_modules/.vite tsconfig.tsbuildinfo .vitest coverage && find src -type d -name __traces__ -prune -exec rm -rf {} +"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.11",
    "clsx": "^2.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "lucide-react": "^0.545.0",
    "marked": "^18.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "jsdom": "^28.1.0",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
